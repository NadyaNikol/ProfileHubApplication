<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contacts_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.contacts.fragment.ContactsDetailViewFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <View
        android:id="@+id/viewProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorBackground"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPhotoProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/desc_photo_profile"
        android:src="@drawable/ic_person"
        app:layout_constraintBottom_toTopOf="@id/tvNameProfile"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNameProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="@dimen/margin_end"
        android:gravity="center"
        android:textColor="@color/colorOnBackground"
        android:textSize="@dimen/header_two_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/tvCareerProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivPhotoProfile"
        tools:text="Jenny Walker" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCareerProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margin_end"
        android:gravity="center"
        android:textColor="@color/colorOnSurface"
        android:textSize="@dimen/header_three_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/tvAddressProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNameProfile"
        tools:text="Make-up artist" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAddressProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/colorOnSurface"
        android:textSize="@dimen/header_three_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCareerProfile"
        app:layout_constraintWidth_percent="0.7"
        tools:text="775 Westminster Avenue APT D5 Brooklyn, NY, 11230" />

    <!--    second part -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imgBtnFacebookIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:contentDescription="@string/desc_facebook_icon"
        android:src="@drawable/ic_facebook"
        app:layout_constraintBottom_toBottomOf="@id/imgBtnLinkedinIcon"
        app:layout_constraintEnd_toStartOf="@id/imgBtnLinkedinIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgBtnLinkedinIcon" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imgBtnLinkedinIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:contentDescription="@string/desc_linkedin_icon"
        android:src="@drawable/ic_linkedin"
        app:layout_constraintBottom_toTopOf="@id/btnMessage"
        app:layout_constraintEnd_toStartOf="@id/imgBtnInstagramIcon"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/imgBtnFacebookIcon"
        app:layout_constraintTop_toBottomOf="@id/guidelineHorizontal"
        app:layout_constraintVertical_bias="0.4" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imgBtnInstagramIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:contentDescription="@string/desc_instagram_icon"
        android:src="@drawable/ic_instagram"
        app:layout_constraintBottom_toBottomOf="@id/imgBtnLinkedinIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgBtnLinkedinIcon"
        app:layout_constraintTop_toTopOf="@id/imgBtnLinkedinIcon" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start"
        android:layout_marginEnd="@dimen/margin_end"
        android:layout_marginBottom="@dimen/margin_bottom"
        android:backgroundTint="@color/colorPrimary"
        android:letterSpacing="@dimen/letter_spacing"
        android:minHeight="@dimen/btn_thick_min_height"
        android:paddingVertical="16dp"
        android:text="@string/btn_message"
        android:textColor="@color/colorOnPrimary"
        android:textSize="@dimen/btn_large_text_size_upper_case"
        app:cornerRadius="@dimen/btn_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/viewOverlayState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorSecondary"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupSomethingWentWrong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="viewOverlayState, ivSomethingWentWrong, tvSomethingVentWrong" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSomethingWentWrong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/ic_noun_scrunched_face"
        app:layout_constraintBottom_toTopOf="@id/tvSomethingVentWrong"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSomethingVentWrong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start"
        android:layout_marginEnd="@dimen/margin_end"
        android:gravity="center"
        android:text="@string/tv_something_went_wrong"
        android:textColor="@color/colorIconErrorTint"
        android:textSize="@dimen/header_one_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSomethingWentWrong" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarLoadData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>